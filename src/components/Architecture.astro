    content: '';
    position: absolute;
    z-index: -1;
    inset: 8% 0 10%;
    background: radial-gradient(ellipse at 50% 45%, #6d3adc0e, transparent 65%);
    pointer-events: none;
  }
  .architecture-shell {
    width: min(1240px, calc(100% - 6rem));
    margin-inline: auto;
  }
  .architecture-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 5rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .section-note {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.65rem;
