---
import { showcaseProducts } from '../content/visuals';
import '../styles/project-showcase.css';
---

<section
  class="project-showcase shell section-space"
  id="trabalho"
  aria-labelledby="showcase-title"
>
  <header class="project-showcase__header">
    <h2 id="showcase-title">Produtos que saíram do código.</h2>
    <p>
      Sites, plataformas e experiências de compra que ajudei a construir. Aqui,
      a engenharia ganha uma forma que você pode ver.
    </p>
  </header>

  <div class="project-showcase__grid">
    {showcaseProducts.map((product, index) => (
      <article
        class="project-showcase__product"
        style={`--product-color: ${product.color}`}
      >
        <a
          class="project-showcase__link"
          href={product.href}
          aria-labelledby={`showcase-product-${index}`}
        >
          <figure class="project-showcase__figure">
            <div class="project-showcase__image-frame">
              <img
                src={product.image.src}
                alt={product.image.alt}
                width={product.image.width}
                height={product.image.height}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1100px) 380px, (min-width: 761px) 30vw, calc(100vw - 40px)"
              />
            </div>
            <figcaption>{product.image.caption}</figcaption>
          </figure>
          <div class="project-showcase__copy">
            <p class="project-showcase__role">{product.role}</p>
            <h3 id={`showcase-product-${index}`}>{product.title}</h3>
            <p class="project-showcase__description">{product.description}</p>
            <span class="project-showcase__action">
              Conheça a construção
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" />
              </svg>
            </span>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>
