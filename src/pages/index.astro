---
import PortfolioBody from '../components/PortfolioBody.astro';
import { site } from '../content/portfolio';
import '../styles/global.css';
const nav = [
  { href: '#impacto', label: 'Impacto' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#trajetoria', label: 'Trajetória' },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: 'https://rodolfo-santos.github.io/',
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <title>{site.name} | Engenharia, arquitetura e liderança</title>
    <meta name="description" content={site.intro} />
    <link rel="canonical" href="https://rodolfo-santos.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta
      property="og:title"
      content={site.name + ' | Engenharia que conecta'}
    />
    <meta property="og:description" content={site.intro} />
    <meta property="og:url" content="https://rodolfo-santos.github.io/" />
    <meta
      property="og:image"
      content="https://rodolfo-santos.github.io/images/portrait.webp"
    />
    <meta property="og:image:alt" content={'Retrato de ' + site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/sora-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <div class="reading-progress" data-progress aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href="#inicio" aria-label={site.name + ', início'}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <path
                d="M7 27V9h8c8 0 9 11 0 11H7m8 0 8 7M30 9c-9-2-13 6-5 8 10 2 5 13-3 10"
                stroke="currentColor"
                stroke-width="2.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="brand-name">
            Rodolfo Santos<span>Software & arquitetura</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="navigation"
          aria-label="Abrir navegação"
        >
          <span></span>
          <span></span>
        </button>
        <nav
          class="main-nav"
          id="navigation"
          aria-label="Navegação principal"
          data-menu-panel
        >
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a class="nav-contact" href="#contato">
            Vamos conversar <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <section class="hero shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy" data-hero-copy>
          <p class="hero-name">{site.name}</p>
          <p class="role-label">
            {site.role} <span aria-hidden="true">·</span> {site.employer}
          </p>
          <h1 id="hero-title">
            {site.headlineLines.map((line) => (
              <span>{line}</span>
            ))}
          </h1>
          <p class="hero-intro">{site.intro}</p>
          <div class="hero-opportunities">
            <span>{site.opportunitiesLabel}</span>
            <p>{site.opportunities}</p>
          </div>
          <div class="hero-actions">
            <a
              class="button button-primary"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              Conversar no LinkedIn <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-outline" href="#impacto">
              Ver o impacto do meu trabalho
            </a>
          </div>
          <a class="text-link hero-resume" href={site.resumeHref}>
            {site.resumeLabel} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-art" data-hero-portrait>
          <div class="portrait-stage" data-tilt>
            <div class="portrait-orbit orbit-one" aria-hidden="true"></div>
            <div class="portrait-orbit orbit-two" aria-hidden="true"></div>
            <div class="portrait-frame">
              <img
                class="hero-portrait"
                src="/images/portrait.webp"
                width="460"
                height="460"
                alt={'Retrato de ' + site.name}
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
          <p class="portrait-footnote">
            Liderança com atuação direta na construção de software.
          </p>
        </div>
        <a class="scroll-cue" href="#impacto">
          <span class="scroll-track" aria-hidden="true">
            <i></i>
          </span>
          Explore o que eu construo
        </a>
      </section>
      <PortfolioBody />
      <section
        class="contact-section shell section-space"
        id="contato"
        aria-labelledby="contact-title"
        data-reveal
      >
        <div class="contact-glow" aria-hidden="true"></div>
        <p class="section-intro">Boas conexões começam com uma conversa</p>
        <h2 id="contact-title">
          Vamos conversar
          <br />
          sobre oportunidades.
        </h2>
        <p>
          Engenharia Sênior, Staff ou gestão de engenharia.
          <br class="desktop-break" /> Conheça minha trajetória e vamos falar
          sobre o desafio do seu time.
        </p>
        <div class="contact-actions">
          <a
            class="button button-primary"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conversar no LinkedIn{' '}
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15 15 5M5 5h10v10" />
            </svg>
          </a>
          <a class="button button-outline" href={site.resumeHref}>
            {site.resumeLabel}
          </a>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <a class="footer-name" href="#inicio">
        Rodolfo Santos<span>Engenharia que conecta.</span>
      </a>
      <p>
        Feito com intenção.
        <br />E em constante evolução.
      </p>
      <a class="back-top" href="#inicio">
        Voltar ao início <span aria-hidden="true">↑</span>
      </a>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
