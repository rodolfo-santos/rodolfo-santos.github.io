---
import Architecture from '../components/Architecture.astro';
import { site, cases, timeline, teaching } from '../content/portfolio';
import '../styles/global.css';
const nav = [
  { href: '#trabalho', label: 'Trabalho' },
  { href: '#abordagem', label: 'Abordagem' },
  { href: '#trajetoria', label: 'Trajetória' },
];
const capabilities = [
  {
    label: 'Arquitetura distribuída',
    icon: 'M5 6h5v5H5zM19 6h5v5h-5zM12 19h5v5h-5zM10 8.5h9M7.5 11v4h7v4M21.5 11v4h-7',
  },
  {
    label: 'Pagamentos e financeiro',
    icon: 'M4 8h22v16H4zM4 13h22M8 19h5M8 5h14',
  },
  {
    label: 'Produtos de ponta a ponta',
    icon: 'M4 6h22v18H4zM4 11h22M8 8.5h.1M11 8.5h.1M12 15l-3 3 3 3M18 15l3 3-3 3',
  },
  {
    label: 'Pessoas e engenharia com IA',
    icon: 'M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 25v-3a7 7 0 0 1 14 0v3M23 5v8M19 9h8M23 18v6M20 21h6',
  },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: 'https://rodolfo-santos.github.io/',
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <title>{site.name} | Engenharia, arquitetura e liderança</title>
    <meta name="description" content={site.intro} />
    <link rel="canonical" href="https://rodolfo-santos.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta
      property="og:title"
      content={site.name + ' | Engenharia que conecta'}
    />
    <meta property="og:description" content={site.intro} />
    <meta property="og:url" content="https://rodolfo-santos.github.io/" />
    <meta
      property="og:image"
      content="https://rodolfo-santos.github.io/images/portrait.webp"
    />
    <meta property="og:image:alt" content={'Retrato de ' + site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/sora-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <div class="reading-progress" data-progress aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href="#inicio" aria-label={site.name + ', início'}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <path
                d="M7 27V9h8c8 0 9 11 0 11H7m8 0 8 7M30 9c-9-2-13 6-5 8 10 2 5 13-3 10"
                stroke="currentColor"
                stroke-width="2.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="brand-name">
            Rodolfo Santos<span>Software & arquitetura</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="navigation"
          aria-label="Abrir navegação"
        >
          <span></span>
          <span></span>
        </button>
        <nav
          class="main-nav"
          id="navigation"
          aria-label="Navegação principal"
          data-menu-panel
        >
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a class="nav-contact" href="#contato">
            Vamos conversar <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <section class="hero shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy" data-hero-copy>
          <p class="role-label">
            <span aria-hidden="true"></span>
            {site.role}
          </p>
          <h1 id="hero-title">
            {site.headlineLines.map((line) => (
              <span>{line}</span>
            ))}
          </h1>
          <p class="hero-intro">{site.intro}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#trabalho">
              Conheça meu trabalho{' '}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" />
              </svg>
            </a>
            <a
              class="text-link"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              Meu LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="hero-note">
            <span class="note-line" aria-hidden="true"></span>
            <p>
              Do código que sustenta o produto
              <br />
              às pessoas que o fazem evoluir.
            </p>
          </div>
        </div>
        <div class="hero-art" data-hero-portrait>
          <div class="portrait-stage" data-tilt>
            <div class="portrait-orbit orbit-one" aria-hidden="true"></div>
            <div class="portrait-orbit orbit-two" aria-hidden="true"></div>
            <span class="stage-cross cross-one" aria-hidden="true">
              +
            </span>
            <span class="stage-cross cross-two" aria-hidden="true">
              +
            </span>
            <div class="portrait-frame">
              <img
                class="hero-portrait"
                src="/images/portrait.webp"
                width="460"
                height="460"
                alt={'Retrato de ' + site.name}
                loading="eager"
                fetchpriority="high"
              />
              <div class="portrait-caption">
                <span>Rodolfo dos Santos</span>
                <span>Engenharia com contexto.</span>
              </div>
            </div>
            <div class="floating-note floating-architecture" aria-hidden="true">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 17l9 5 9-5" />
                </svg>
              </span>
              <div>
                <span>Conexões que importam</span>
                <strong>Produto + arquitetura</strong>
              </div>
            </div>
            <div class="floating-note floating-code" aria-hidden="true">
              <span class="status-dot"></span>
              <span>Construir. Conectar. Evoluir.</span>
            </div>
          </div>
          <div class="portrait-footnote">
            <span class="mini-orbit" aria-hidden="true"></span>Software com
            profundidade. Pessoas no centro.
          </div>
        </div>
        <a class="scroll-cue" href="#trabalho">
          <span class="scroll-track" aria-hidden="true">
            <i></i>
          </span>
          Explore o que eu construo
        </a>
      </section>
      <div class="capability-band shell" aria-label="Áreas de atuação">
        {capabilities.map((item) => (
          <div class="capability">
            <svg viewBox="0 0 30 30" fill="none" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
      <section
        class="work-section shell section-space"
        id="trabalho"
        aria-labelledby="work-title"
      >
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-intro">Trabalho que conecta</p>
            <h2 id="work-title">
              Sistemas complexos.
              <br />
              Valor no mundo real.
            </h2>
          </div>
          <p>
            Da experiência de quem usa à operação que sustenta o negócio.
            Algumas frentes em que conecto essas pontas.
          </p>
        </div>
        <div class="case-list">
          {cases.map((item, index) => (
            <article
              class:list={[
                'case-study',
                'case-' + item.theme,
                { 'case-reverse': index === 1 },
              ]}
              id={item.id}
              data-reveal
            >
              <div class="case-copy">
                <p class="case-kicker">
                  <span class="case-symbol" aria-hidden="true">
                    {index === 0 ? '⌁' : index === 1 ? '◈' : '✳'}
                  </span>
                  {item.kicker}
                </p>
                <h3>{item.title}</h3>
                <p class="case-description">{item.description}</p>
                <p class="case-role">{item.role}</p>
                <ul class="tag-list" aria-label="Temas e tecnologias">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <details class="case-details">
                  <summary>
                    Por dentro da construção <span aria-hidden="true">+</span>
                  </summary>
                  <div class="case-details-body">
                    {item.details.map((detail) => (
                      <p>{detail}</p>
                    ))}
                  </div>
                </details>
              </div>
              <div
                class:list={['case-visual', 'visual-' + index]}
                aria-hidden="true"
                data-tilt
              >
                {index === 0 ? (
                  <div class="payment-scene">
                    <div class="scene-topline">
                      <span class="scene-dot"></span>Uma jornada, pontas
                      conectadas
                    </div>
                    <div class="payment-node">
                      <span class="node-icon">↗</span>
                      <div>
                        <small>O ponto de partida</small>
                        <strong>Checkout</strong>
                      </div>
                      <span class="node-check">✓</span>
                    </div>
                    <div class="flow-connector">
                      <i></i>
                      <span>eventos & integrações</span>
                    </div>
                    <div class="payment-node node-core">
                      <span class="node-icon">⌘</span>
                      <div>
                        <small>O centro da operação</small>
                        <strong>Pagamentos</strong>
                      </div>
                      <span class="node-orbit"></span>
                    </div>
                    <div class="flow-branch"></div>
                    <div class="payment-destinations">
                      <div>
                        <span>↻</span>Recorrência
                      </div>
                      <div>
                        <span>≋</span>Financeiro
                      </div>
                    </div>
                    <div class="scene-bottomline">
                      <span></span>Da transação à conciliação
                    </div>
                  </div>
                ) : index === 1 ? (
                  <div class="web-scene">
                    <div class="browser-toolbar">
                      <span></span>
                      <span></span>
                      <span></span>
                      <i>Produto, conteúdo e experiência</i>
                    </div>
                    <div class="browser-content">
                      <div class="browser-nav">
                        <span class="browser-logo"></span>
                        <div>
                          <i></i>
                          <i></i>
                          <i></i>
                        </div>
                        <span class="browser-action"></span>
                      </div>
                      <div class="browser-hero">
                        <div>
                          <span class="skeleton skeleton-label"></span>
                          <span class="skeleton skeleton-title"></span>
                          <span class="skeleton skeleton-title short"></span>
                          <span class="skeleton skeleton-copy"></span>
                          <span class="skeleton skeleton-copy shorter"></span>
                          <span class="skeleton skeleton-button"></span>
                        </div>
                        <div class="browser-art">
                          <span class="browser-shape shape-one"></span>
                          <span class="browser-shape shape-two"></span>
                          <span class="browser-shape shape-three"></span>
                        </div>
                      </div>
                      <div class="browser-products">
                        <span></span>
                        <span></span>
                        <span></span>
                      </div>
                    </div>
                    <div class="web-note">
                      <span>↗</span>
                      <div>
                        <strong>Uma base. Múltiplas experiências.</strong>
                        <small>Arquitetura que dá espaço ao produto.</small>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="ai-scene">
                    <div class="scene-topline">
                      <span class="scene-dot"></span>Engenharia com IA
                    </div>
                    <div class="ai-orbit">
                      <div class="ai-orbit-ring ring-one"></div>
                      <div class="ai-orbit-ring ring-two"></div>
                      <div class="ai-core">
                        <svg viewBox="0 0 52 52" fill="none">
                          <path d="m26 7 5 13 14 6-14 5-5 14-6-14-13-5 13-6 6-13Z" />
                          <path d="m41 4 2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5Z" />
                        </svg>
                      </div>
                      <span class="ai-satellite satellite-spec">
                        Especificação
                      </span>
                      <span class="ai-satellite satellite-code">
                        Implementação
                      </span>
                      <span class="ai-satellite satellite-test">Validação</span>
                    </div>
                    <div class="ai-terminal">
                      <span class="terminal-prompt">›</span>
                      <span>
                        contexto claro<span class="terminal-plus"> + </span>
                        feedback contínuo
                      </span>
                      <i></i>
                    </div>
                    <div class="scene-bottomline">
                      Intenção humana. Execução ampliada.
                    </div>
                  </div>
                )}
                <span class="concept-label">Representação conceitual</span>
              </div>
            </article>
          ))}
        </div>
      </section>
      <Architecture />
      <section
        class="journey-section shell section-space"
        id="trajetoria"
        aria-labelledby="journey-title"
      >
        <div class="journey-intro" data-reveal>
          <p class="section-intro">Trajetória em construção contínua</p>
          <h2 id="journey-title">
            Aprofundar a técnica.
            <br />
            Ampliar o olhar.
          </h2>
          <p>
            Desenvolvimento, arquitetura e liderança fazem parte da mesma
            história: entender o problema, construir junto e sustentar a
            evolução.
          </p>
          <a
            class="text-link"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Trajetória completa no LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="timeline">
          <div class="timeline-track" aria-hidden="true">
            <span data-timeline-line></span>
          </div>
          {timeline.map((item) => (
            <article class="timeline-item" data-timeline-item>
              <span class="timeline-point" aria-hidden="true"></span>
              <p class="timeline-period">{item.period}</p>
              <h3>{item.company}</h3>
              <p class="timeline-role">{item.role}</p>
              <p class="timeline-description">{item.description}</p>
            </article>
          ))}
        </div>
      </section>
      <section
        class="teaching-section shell"
        aria-labelledby="teaching-title"
        data-reveal
      >
        <div class="teaching-symbol" aria-hidden="true">
          <svg viewBox="0 0 80 80" fill="none">
            <path d="M13 19h21c5 0 6 3 6 5v41c0-6-6-7-12-7H13V19Zm54 0H46c-5 0-6 3-6 5v41c0-6 6-7 12-7h15V19Z" />
            <path d="M21 29h10M21 37h10M49 29h10M49 37h10" />
          </svg>
        </div>
        <div>
          <p class="section-intro">Conhecimento que circula</p>
          <h2 id="teaching-title">{teaching.title}</h2>
          <p>{teaching.body}</p>
        </div>
        <span class="teaching-orbit" aria-hidden="true"></span>
      </section>
      <section
        class="contact-section shell section-space"
        id="contato"
        aria-labelledby="contact-title"
        data-reveal
      >
        <div class="contact-glow" aria-hidden="true"></div>
        <p class="section-intro">Boas conexões começam com uma conversa</p>
        <h2 id="contact-title">
          O próximo desafio
          <br />
          pode conectar a gente.
        </h2>
        <p>
          Vamos conversar sobre software, arquitetura,
          <br class="desktop-break" /> engenharia com IA ou desenvolvimento de
          pessoas.
        </p>
        <div class="contact-actions">
          <a
            class="button button-primary"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conversar no LinkedIn{' '}
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15 15 5M5 5h10v10" />
            </svg>
          </a>
          <a
            class="button button-outline"
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 19c-4 1-4-2-6-2m12 5v-3.5c0-1 .1-1.5-.5-2 3.2-.4 6.5-1.5 6.5-7A5.5 5.5 0 0 0 19.5 6a5 5 0 0 0-.1-3.5S18.2 2.1 15 4a13 13 0 0 0-6 0C5.8 2.1 4.6 2.5 4.6 2.5A5 5 0 0 0 4.5 6 5.5 5.5 0 0 0 3 9.5c0 5.5 3.3 6.6 6.5 7-.6.5-.6 1.1-.5 2V22" />
            </svg>
            Explorar meu GitHub
          </a>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <a class="footer-name" href="#inicio">
        Rodolfo Santos<span>Engenharia que conecta.</span>
      </a>
      <p>
        Feito com intenção.
        <br />E em constante evolução.
      </p>
      <a class="back-top" href="#inicio">
        Voltar ao início <span aria-hidden="true">↑</span>
      </a>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
