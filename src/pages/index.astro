---
import PortfolioBody from '../components/PortfolioBody.astro';
import { site } from '../content/portfolio';
import '../styles/global.css';
import '../styles/editorial.css';
const nav = [
  { href: '#impacto', label: 'Impacto' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#trajetoria', label: 'Trajetória' },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: 'https://rodolfo-santos.github.io/',
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e8" />
    <script is:inline>
      document.documentElement.classList.add('js-menu-ready');
    </script>
    <title>{site.name} | Engenharia, arquitetura e liderança</title>
    <meta name="description" content={site.intro} />
    <link rel="canonical" href="https://rodolfo-santos.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta
      property="og:title"
      content={site.name + ' | Engenharia que conecta'}
    />
    <meta property="og:description" content={site.intro} />
    <meta property="og:url" content="https://rodolfo-santos.github.io/" />
    <meta
      property="og:image"
      content="https://rodolfo-santos.github.io/images/portrait.webp"
    />
    <meta property="og:image:alt" content={'Retrato de ' + site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/sora-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class="editorial-page">
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <div class="reading-progress" data-progress aria-hidden="true"></div>
    <header class="site-header editorial-header">
      <div class="header-inner shell">
        <a class="brand" href="#inicio">
          <span class="editorial-monogram" aria-hidden="true">
            r<span>.</span>s
          </span>
          <span class="editorial-brand-caption">
            Software, arquitetura
            <br />e pessoas.
          </span>
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="navigation"
          aria-label="Abrir navegação"
        >
          <span></span>
          <span></span>
        </button>
        <nav
          class="main-nav"
          id="navigation"
          aria-label="Navegação principal"
          data-menu-panel
        >
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a class="nav-contact" href="#contato">
            Vamos conversar <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <div class="editorial-opening">
        <section
          class="editorial-hero shell"
          id="inicio"
          aria-labelledby="hero-title"
          data-editorial-hero
        >
          <div class="editorial-identity">
            <h1 id="hero-title" data-editorial-title>
              <span>Rodolfo</span>{' '}
              <span>
                dos Santos
                <span class="editorial-name-stop" aria-hidden="true">
                  .
                </span>
              </span>
            </h1>
            <p class="editorial-role">
              <span>{site.role}</span>
              <span class="editorial-employer">na {site.employer}</span>
            </p>
          </div>
          <figure class="editorial-portrait" data-editorial-portrait>
            <div class="editorial-photo-mat">
              <img
                src="/images/portrait.webp"
                width="460"
                height="460"
                alt={'Retrato de ' + site.name}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
            <figcaption>{site.roleDescription}</figcaption>
          </figure>
          <div class="editorial-introduction">
            <h2>{site.headlineLines.join(' ')}</h2>
            <p>{site.intro}</p>
            <div class="editorial-actions">
              <a
                class="button button-primary"
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                Conversar no LinkedIn <span aria-hidden="true">↗</span>
              </a>
              <a class="button editorial-resume" href={site.resumeHref}>
                {site.resumeLabel} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <a class="editorial-explore" href="#impacto">
            <span>Explore o que eu construo</span>
            <span class="editorial-explore-icon" aria-hidden="true">
              ↓
            </span>
          </a>
        </section>
        <aside
          class="editorial-availability shell"
          aria-label={site.opportunitiesLabel}
        >
          <p>{site.opportunitiesLabel}</p>
          <p>{site.opportunities}</p>
          <a href="#trajetoria">
            Conheça minha trajetória <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
      <div class="editorial-body" data-editorial-chapter>
        <div
          class="editorial-chapter-edge"
          data-editorial-chapter-surface
          aria-hidden="true"
        ></div>
        <PortfolioBody />
      </div>
      <section
        class="contact-section editorial-contact"
        id="contato"
        aria-labelledby="contact-title"
      >
        <div class="shell">
          <div class="editorial-contact-intro">
            <span>Rodolfo dos Santos</span>
            <span>Uma próxima conversa.</span>
          </div>
          <h2 id="contact-title">
            Vamos
            <br />
            <span>conversar.</span>
          </h2>
          <div class="editorial-contact-bottom">
            <p>
              Engenharia Sênior, Staff ou gestão de engenharia. Conheça minha
              trajetória e vamos falar sobre o desafio do seu time.
            </p>
            <div class="contact-actions">
              <a
                class="button button-primary"
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                Conversar no LinkedIn <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-outline" href={site.resumeHref}>
                {site.resumeLabel} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer shell editorial-footer">
      <a class="footer-name" href="#inicio">
        Rodolfo dos Santos<span>Software, arquitetura e pessoas.</span>
      </a>
      <a
        class="editorial-footer-github"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a class="back-top" href="#inicio">
        Voltar ao início <span aria-hidden="true">↑</span>
      </a>
    </footer>
    <script>
      import '../scripts/motion';
      import '../scripts/editorial-motion';
    </script>
  </body>
</html>
