---
import PortfolioBody from '../components/PortfolioBody.astro';
import { site } from '../content/portfolio';
import '../styles/global.css';
const nav = [
  { href: '#trabalho', label: 'Trabalho' },
  { href: '#abordagem', label: 'Abordagem' },
  { href: '#trajetoria', label: 'Trajetória' },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: 'https://rodolfo-santos.github.io/',
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <title>{site.name} | Engenharia, arquitetura e liderança</title>
    <meta name="description" content={site.intro} />
    <link rel="canonical" href="https://rodolfo-santos.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta
      property="og:title"
      content={site.name + ' | Engenharia que conecta'}
    />
    <meta property="og:description" content={site.intro} />
    <meta property="og:url" content="https://rodolfo-santos.github.io/" />
    <meta
      property="og:image"
      content="https://rodolfo-santos.github.io/images/portrait.webp"
    />
    <meta property="og:image:alt" content={'Retrato de ' + site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/sora-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <div class="reading-progress" data-progress aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href="#inicio" aria-label={site.name + ', início'}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <path
                d="M7 27V9h8c8 0 9 11 0 11H7m8 0 8 7M30 9c-9-2-13 6-5 8 10 2 5 13-3 10"
                stroke="currentColor"
                stroke-width="2.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="brand-name">
            Rodolfo Santos<span>Software & arquitetura</span>
          </span>
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="navigation"
          aria-label="Abrir navegação"
        >
          <span></span>
          <span></span>
        </button>
        <nav
          class="main-nav"
          id="navigation"
          aria-label="Navegação principal"
          data-menu-panel
        >
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a class="nav-contact" href="#contato">
            Vamos conversar <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <section class="hero shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy" data-hero-copy>
          <p class="role-label">
            <span aria-hidden="true"></span>
            {site.role}
          </p>
          <h1 id="hero-title">
            {site.headlineLines.map((line) => (
              <span>{line}</span>
            ))}
          </h1>
          <p class="hero-intro">{site.intro}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#trabalho">
              Conheça meu trabalho{' '}
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" />
              </svg>
            </a>
            <a
              class="text-link"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              Meu LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="hero-note">
            <span class="note-line" aria-hidden="true"></span>
            <p>
              Uma trajetória em tecnologia desde 2014.
              <br />
              Da sala de aula à arquitetura financeira.
            </p>
          </div>
        </div>
        <div class="hero-art" data-hero-portrait>
          <div class="portrait-stage" data-tilt>
            <div class="portrait-orbit orbit-one" aria-hidden="true"></div>
            <div class="portrait-orbit orbit-two" aria-hidden="true"></div>
            <span class="stage-cross cross-one" aria-hidden="true">
              +
            </span>
            <span class="stage-cross cross-two" aria-hidden="true">
              +
            </span>
            <div class="portrait-frame">
              <img
                class="hero-portrait"
                src="/images/portrait.webp"
                width="460"
                height="460"
                alt={'Retrato de ' + site.name}
                loading="eager"
                fetchpriority="high"
              />
              <div class="portrait-caption">
                <span>Rodolfo dos Santos</span>
                <span>Implementação · arquitetura · liderança.</span>
              </div>
            </div>
            <div class="floating-note floating-architecture" aria-hidden="true">
              <span class="floating-icon">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 17l9 5 9-5" />
                </svg>
              </span>
              <div>
                <span>Payments Engineering Manager</span>
                <strong>Qeevo Group</strong>
              </div>
            </div>
            <div class="floating-note floating-code" aria-hidden="true">
              <span class="status-dot"></span>
              <span>Construir. Conectar. Evoluir.</span>
            </div>
          </div>
          <div class="portrait-footnote">
            <span class="mini-orbit" aria-hidden="true"></span>Software com
            profundidade. Pessoas no centro.
          </div>
        </div>
        <a class="scroll-cue" href="#trabalho">
          <span class="scroll-track" aria-hidden="true">
            <i></i>
          </span>
          Explore o que eu construo
        </a>
      </section>
      <PortfolioBody />
      <section
        class="contact-section shell section-space"
        id="contato"
        aria-labelledby="contact-title"
        data-reveal
      >
        <div class="contact-glow" aria-hidden="true"></div>
        <p class="section-intro">Boas conexões começam com uma conversa</p>
        <h2 id="contact-title">
          O próximo desafio
          <br />
          pode conectar a gente.
        </h2>
        <p>
          Vamos conversar sobre software, arquitetura,
          <br class="desktop-break" /> engenharia com IA ou desenvolvimento de
          pessoas.
        </p>
        <div class="contact-actions">
          <a
            class="button button-primary"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conversar no LinkedIn{' '}
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15 15 5M5 5h10v10" />
            </svg>
          </a>
          <a
            class="button button-outline"
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 19c-4 1-4-2-6-2m12 5v-3.5c0-1 .1-1.5-.5-2 3.2-.4 6.5-1.5 6.5-7A5.5 5.5 0 0 0 19.5 6a5 5 0 0 0-.1-3.5S18.2 2.1 15 4a13 13 0 0 0-6 0C5.8 2.1 4.6 2.5 4.6 2.5A5 5 0 0 0 4.5 6 5.5 5.5 0 0 0 3 9.5c0 5.5 3.3 6.6 6.5 7-.6.5-.6 1.1-.5 2V22" />
            </svg>
            Explorar meu GitHub
          </a>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <a class="footer-name" href="#inicio">
        Rodolfo Santos<span>Engenharia que conecta.</span>
      </a>
      <p>
        Feito com intenção.
        <br />E em constante evolução.
      </p>
      <a class="back-top" href="#inicio">
        Voltar ao início <span aria-hidden="true">↑</span>
      </a>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
